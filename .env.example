# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (Neon / Supabase / Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/webchat?schema=public"

# Authentication
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-characters"

# Cloud Storage Adapter (local | supabase | cloudinary)
STORAGE_PROVIDER="local"
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# SUPABASE_STORAGE_BUCKET="attachments"
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_UPLOAD_PRESET="your-upload-preset"
# CLOUDINARY_API_KEY="your-api-key"

# Rich Media (Optional - falls back to built-in curated GIFs if omitted)
# GIPHY_API_KEY="your-giphy-api-key"

