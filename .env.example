# Server Configuration
PORT=4000
NODE_ENV=development

# Required in every environment (`memory:` is accepted only under NODE_ENV=test)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/webchat?schema=public"

# Required: the origin the browser sees (Vite dev server in development)
APP_ORIGIN="http://localhost:5173"

# Required, at least 32 bytes. There is no default; generate one with: openssl rand -base64 48
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-characters"

# Attachment storage (local | supabase). Production requires supabase.
STORAGE_PROVIDER="local"
# SUPABASE_URL="https://your-project.supabase.co"
# A Supabase secret key (sb_secret_...), not the legacy anon or service_role JWT keys
# SUPABASE_SECRET_KEY="your-supabase-secret-key"
# SUPABASE_STORAGE_BUCKET="attachments"

# Rich Media (Optional - falls back to built-in curated GIFs if omitted)
# GIPHY_API_KEY="your-giphy-api-key"
