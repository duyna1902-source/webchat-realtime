# Server configuration, read by server/src/config.ts.
# Copy this file to server/.env: the server, the CLI commands and Prisma all load `.env`
# from the server/ directory. Never commit a real value (see "Secret scanning" in README.md).
# On Render, secrets are set in the dashboard, never in render.yaml.

# development | test | production (default: development)
NODE_ENV=development
# Port to listen on (default: 4000; Render uses 10000)
PORT=4000

# Required in every environment. Postgres connection string (`memory:` is accepted only under NODE_ENV=test).
# For Supabase use the direct or session-mode connection, not the transaction pooler on port 6543:
# `prisma migrate deploy` fails through it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/webchat?schema=public"

# Required: the origin the browser sees. In development that is the Vite dev server, which proxies
# /api, /socket.io and /uploads to this server. Production: https://webchat-realtime.onrender.com
APP_ORIGIN="http://localhost:5173"

# Attachment storage: local | supabase. Production requires supabase (local disk is refused).
STORAGE_PROVIDER="local"
# Required when STORAGE_PROVIDER=supabase:
# SUPABASE_URL="https://your-project.supabase.co"
# A Supabase secret key (sb_secret_...), not the legacy anon or service_role JWT keys
# SUPABASE_SECRET_KEY="your-supabase-secret-key"
# SUPABASE_STORAGE_BUCKET="attachments"

# Optional: fatal | error | warn | info | debug | trace | silent (default: info)
# LOG_LEVEL="info"

# Optional: GIF search falls back to built-in curated GIFs if omitted
# GIPHY_API_KEY="your-giphy-api-key"
