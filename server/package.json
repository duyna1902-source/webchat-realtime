{
  "name": "@webchat/server",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API and Socket.io server for Web Chat Real-Time",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:schema-sql": "node scripts/generate-schema-sql.mjs",
    "db:upgrade-data": "tsx src/cli/upgrade-data.ts",
    "sessions:revoke": "tsx src/cli/revoke-sessions.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@webchat/shared": "*",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pg": "^8.13.1",
    "pglite-prisma-adapter": "^0.7.2",
    "pino": "^10.4.0",
    "prisma": "^7.10.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
