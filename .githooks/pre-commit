#!/bin/sh
# Blocks the commit when the staged changes contain a secret.
# Enable once per clone: git config core.hooksPath .githooks
# Requires gitleaks >= 8.19 on PATH. See README "Secret scanning".

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so staged changes cannot be checked for secrets." >&2
  echo "pre-commit: install it (see README \"Secret scanning\") and commit again." >&2
  exit 1
fi

exec gitleaks git --pre-commit --staged --redact --no-banner --verbose
